---
import { site, fullAddress, telHref, whatsappHref } from '../data/site';

const tel = telHref();
const wa = whatsappHref();
const year = new Date().getFullYear();

const serviceLinks = [
  { href: '/wallpapers/customised-printed/', label: 'Customised wallpaper' },
  { href: '/wallpapers/3d/', label: '3D wallpaper' },
  { href: '/wallpapers/waterproof/', label: 'Waterproof wallpaper' },
  { href: '/wallpapers/kids-room/', label: "Kids' room" },
  { href: '/services/wallpaper-installation/', label: 'Installation' },
  { href: '/services/full-room-makeover/', label: 'Full-room makeover' },
];

const areaLinks = [
  { href: '/wallpaper-shop-sector-19-faridabad/', label: 'Sector 19' },
  { href: '/interior-designer-nit-faridabad/', label: 'NIT Faridabad' },
  { href: '/greater-faridabad/', label: 'Greater Faridabad' },
  { href: '/ballabgarh/', label: 'Ballabgarh' },
];
---

<footer class="divider mt-auto bg-cream-dark/40">
  <div class="container-site section-pad !py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <p class="font-heading text-xl font-semibold text-charcoal">{site.name}</p>
        <p class="text-sm leading-relaxed text-charcoal-muted">{site.tagline}</p>
        <address class="not-italic text-sm leading-relaxed text-charcoal-muted">
          {fullAddress()}
        </address>
        <p class="text-sm text-charcoal-muted">
          <span class="font-medium text-charcoal">Hours:</span>
          {site.hours.display}
          {
            site.hours.note && (
              <>
                <br />
                <span class="text-charcoal-muted/80">{site.hours.note}</span>
              </>
            )
          }
        </p>
        <div class="flex flex-wrap gap-3 pt-1">
          {
            tel && (
              <a href={tel} class="btn-secondary text-sm" data-track="call_click" data-track-location="footer">
                Call
              </a>
            )
          }
          {
            wa && (
              <a
                href={wa}
                class="btn-primary text-sm"
                data-track="whatsapp_click"
                data-track-location="footer"
                target="_blank"
                rel="noopener noreferrer"
              >
                WhatsApp
              </a>
            )
          }
        </div>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold tracking-wide text-charcoal uppercase">Services</p>
        <ul class="space-y-2">
          {
            serviceLinks.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-charcoal-muted no-underline hover:text-terracotta">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold tracking-wide text-charcoal uppercase">Areas we serve</p>
        <ul class="space-y-2">
          {
            areaLinks.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-charcoal-muted no-underline hover:text-terracotta">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-xs text-charcoal-muted/80">
          Also: {site.serviceArea.areas.slice(0, 6).join(', ')} & {site.serviceArea.nearby}
        </p>
      </div>

      <div>
        <p class="mb-3 text-sm font-semibold tracking-wide text-charcoal uppercase">Explore</p>
        <ul class="space-y-2">
          <li><a href="/projects/" class="text-sm text-charcoal-muted no-underline hover:text-terracotta">Projects</a></li>
          <li><a href="/tools/wallpaper-calculator/" class="text-sm text-charcoal-muted no-underline hover:text-terracotta">Wallpaper calculator</a></li>
          <li><a href="/blog/" class="text-sm text-charcoal-muted no-underline hover:text-terracotta">Blog</a></li>
          <li><a href="/about/" class="text-sm text-charcoal-muted no-underline hover:text-terracotta">About / Studio</a></li>
          <li><a href="/contact/" class="text-sm text-charcoal-muted no-underline hover:text-terracotta">Contact</a></li>
        </ul>
        <div class="mt-4 flex flex-wrap gap-3">
          {
            site.social.instagram && (
              <a href={site.social.instagram} class="text-sm text-charcoal-muted underline" target="_blank" rel="noopener noreferrer">
                Instagram
              </a>
            )
          }
          {
            site.social.facebook && (
              <a href={site.social.facebook} class="text-sm text-charcoal-muted underline" target="_blank" rel="noopener noreferrer">
                Facebook
              </a>
            )
          }
          {
            site.social.pinterest && (
              <a href={site.social.pinterest} class="text-sm text-charcoal-muted underline" target="_blank" rel="noopener noreferrer">
                Pinterest
              </a>
            )
          }
          {
            !site.social.instagram && !site.social.facebook && !site.social.pinterest && (
              <p class="text-xs text-charcoal-muted/70">Social links: TODO-CONFIRM in site.ts</p>
            )
          }
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-charcoal/10 pt-6 text-xs text-charcoal-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. Faridabad, Haryana.</p>
      <div class="flex flex-wrap gap-4">
        <a href="/privacy/" class="no-underline hover:text-charcoal">Privacy</a>
        <a href="/terms/" class="no-underline hover:text-charcoal">Terms</a>
        <a href="/contact/" class="no-underline hover:text-charcoal">{site.cta.primaryHinglish}</a>
      </div>
    </div>
  </div>
</footer>
