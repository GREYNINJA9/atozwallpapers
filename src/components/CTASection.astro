---
import { site } from '../data/site';

interface Props {
  heading?: string;
  subtext?: string;
}
const {
  heading = site.cta.primaryHinglish,
  subtext = 'Tell us your room type and area — we will suggest finishes and share a clear next step.',
} = Astro.props;
---

<section class="section-pad bg-charcoal text-cream" aria-labelledby="cta-heading">
  <div class="container-site flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl fade-up">
      <h2 id="cta-heading" class="text-3xl text-cream sm:text-4xl">{heading}</h2>
      <p class="mt-3 text-cream/75 leading-relaxed">{subtext}</p>
    </div>
    <div class="flex flex-wrap gap-3 fade-up">
      <a
        href="/contact/"
        class="btn bg-terracotta text-cream hover:bg-terracotta-dark"
        data-track="consultation_cta_click"
        data-track-location="cta_section"
      >
        {site.cta.primary}
      </a>
      <a href="/tools/wallpaper-calculator/" class="btn border border-cream/25 text-cream hover:bg-cream/10">
        Get an estimate
      </a>
    </div>
  </div>
</section>
