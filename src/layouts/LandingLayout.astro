---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Analytics from '../components/Analytics.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import { site, telHref, whatsappHref } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const tel = telHref();
const wa = whatsappHref();
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead title={title} description={description} ogImage={ogImage} noindex={true} />
    <Analytics />
  </head>
  <body class="flex min-h-dvh flex-col pb-16">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header minimal={true} />
    <main id="main" class="flex-1">
      <slot />
    </main>

    <!-- Sticky call / WhatsApp for LP -->
    <nav
      class="fixed inset-x-0 bottom-0 z-40 flex border-t border-charcoal/10 bg-cream/95 backdrop-blur-md"
      aria-label="Landing quick contact"
      style="padding-bottom: env(safe-area-inset-bottom);"
    >
      {
        tel ? (
          <a href={tel} class="flex min-h-14 flex-1 items-center justify-center gap-2 text-sm font-medium no-underline hover:bg-cream-dark" data-track="call_click" data-track-location="lp_sticky">
            Call
          </a>
        ) : (
          <span class="flex min-h-14 flex-1 items-center justify-center text-xs text-charcoal-muted">Call TODO</span>
        )
      }
      {
        wa ? (
          <a href={wa} class="flex min-h-14 flex-1 items-center justify-center gap-2 bg-[#25D366] text-sm font-medium text-white no-underline" data-track="whatsapp_click" data-track-location="lp_sticky" target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        ) : (
          <span class="flex min-h-14 flex-1 items-center justify-center text-xs text-charcoal-muted">WhatsApp TODO</span>
        )
      }
    </nav>

    <ConsentBanner />
    <script>
      const ATTR_KEYS = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','msclkid','fbclid'];
      try {
        const params = new URLSearchParams(window.location.search);
        const stored = JSON.parse(sessionStorage.getItem('atoz_attrs') || '{}');
        for (const key of ATTR_KEYS) {
          const v = params.get(key);
          if (v) stored[key] = v;
        }
        if (!stored.landing_page) stored.landing_page = window.location.pathname + window.location.search;
        if (!stored.referrer && document.referrer) stored.referrer = document.referrer;
        sessionStorage.setItem('atoz_attrs', JSON.stringify(stored));
      } catch { /* ignore */ }

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        const els = document.querySelectorAll('.fade-up');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.fade-up').forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
